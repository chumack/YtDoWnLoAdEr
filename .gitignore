```gitignore
# Python
__pycache__/
*.pyc
*.pyo
*.pyd
*.py~
*.py.class
*.py.backup
*.swp
*.swo

# Virtual environments
venv/
.venv/
env/
.ENV/
.env/

# Build and distribution artifacts
build/
dist/
*.egg
*.egg-info/
.installed.cfg
*.egg-info/

# Testing
.coverage
coverage/
htmlcov/
.nox/
.tox/
.pytest_cache/
.hypothesis/

# Linting and type checking
.mypy_cache/
.pyre/
.pytype/
.mercular/
.coverage*/

# Logs
*.log
*.out

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# Environment variables
.env
.env.local
.env.*
!env.example

# IDE specific
.vscode/
.idea/
*.swp
*.swo

# Backup files
*~
*.bak
*.old
*.orig

# Compressed files
*.zip
*.tar.gz
*.tar.bz2
*.tar.xz
*.gz
*.bz2
*.xz
*.7z
*.rar
*.tgz
*.tar
*.zst
*.lz4
*.lzh
